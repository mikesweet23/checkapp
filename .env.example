DATABASE_URL="postgresql://user:password@localhost:5432/checkapp"
# Public address of the check-in site, used for private result links in emails.
# Falls back to the address of the incoming request when empty.
PUBLIC_BASE_URL="https://check.absolutemind.co.uk"

# Admin access is enabled when the password, session secret and at least one
# email are present. Add Mike alongside the existing admin without exposing
# either admin identity on the public check-in pages.
ADMIN_EMAIL="paula@example.com"
ADMIN_ADDITIONAL_EMAILS="mike@mikesweet.co.uk"
ADMIN_PASSWORD="choose-a-long-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
# Who gets the "someone completed a check-in" email. Defaults to the admin emails.
ADMIN_NOTIFY_EMAILS=""

# Email delivery (Resend). Reports are not emailed until both are set.
RESEND_API_KEY=""
REPORT_FROM_EMAIL="reports@example.com"

# Optional CRM sync. Only people who tick the follow-up box are sent.
CRM_WEBHOOK_URL=""
CRM_WEBHOOK_SECRET=""

# Privacy and retention.
PRIVACY_CONTACT_EMAIL=""
DATA_RETENTION_MONTHS="24"
# Vercel Cron sends this as a bearer token to /api/cron/retention.
CRON_SECRET=""
