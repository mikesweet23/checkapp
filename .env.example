DATABASE_URL="postgresql://user:password@localhost:5432/checkapp"
# Admin access is enabled when the password, session secret and at least one
# email are present. Add Mike alongside the existing admin without exposing
# either admin identity on the public check-in pages.
ADMIN_EMAIL="paula@example.com"
ADMIN_ADDITIONAL_EMAILS="mike@mikesweet.co.uk"
ADMIN_PASSWORD="choose-a-long-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
# Optional integrations to wire in behind the services in src/lib/services.
RESEND_API_KEY=""
REPORT_FROM_EMAIL="reports@example.com"
CRM_WEBHOOK_URL=""
CRM_WEBHOOK_SECRET=""
